# Kopiér til .env og udfyld for at teste lokalt (commit ALDRIG .env)

# URL til Air Chinas priskalender for CPH -> CAN (kopiér fra adresselinjen)
AIRCHINA_URL=

TELEGRAM_TOKEN=din_telegram_bot_token
TELEGRAM_CHAT_ID=dit_chat_id

# Valgfrit — standardværdier er sat i koden:
